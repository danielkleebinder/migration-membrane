+__wasi_errno_t
+wasmtime_ssp_update_socket_handle(struct fd_table *curfds, __wasi_fd_t fd,
+                                  os_file_handle new_handle)
+{
+    struct fd_object *fo;
+    __wasi_errno_t error;
+
+    rwlock_rdlock(&curfds->lock);
+    error = fd_table_get_entry(curfds, fd, 0, 0, (struct fd_entry **)&fo);
+    if (error == 0) {
+        // Entry exists, update its handle
+        struct fd_entry *fe = &curfds->entries[fd];
+        fe->object->file_handle = new_handle;
+        rwlock_unlock(&curfds->lock);
+        return 0;
+    }
+    rwlock_unlock(&curfds->lock);
+
+    // Entry does not exist, insert it
+    if (fd_table_insert_existing(curfds, fd, new_handle, false)) {
+        return 0;
+    }
+
+    return __WASI_EBADF;
+}
