+
+static int
+is_numeric(const char *s)
+{
+    while (*s) {
+        if (!isdigit((unsigned char)*s))
+            return 0;
+        s++;
+    }
+    return 1;
+}
+
+// Definition of the global tracker instance
+LiveMigrationMembraneMemoryTracker global_membrane_tracker = { 0 };
+LiveMigrationMembraneMode live_migration_membrane_mode = LIVE_MIGRATION_MODE_DISABLED;
+bool live_migration_teared_down = false;
+
+void
+tear_down_live_migration(void)
+{
+    DIR *dir = opendir("/proc/self/fd");
+    if (!dir) {
+        perror("[FD Search] Failed to open /proc/self/fd");
+        return;
+    }
+
+    int dir_fd = dirfd(dir);
+    struct dirent *entry;
+
+    int fds_to_close[256];
+    int close_count = 0;
+
+    printf("=== Current Open File Descriptors ===\n");
+
+    live_migration_membrane_mode = LIVE_MIGRATION_MODE_DISABLED;
+
+    if (live_migration_udp_dump.os_fd >= 0) {
+        close(live_migration_udp_dump.os_fd);
+        printf("[LM/Checkpoint] Released local UDP socket (OS FD: %i)\n", live_migration_udp_dump.os_fd);
+    }
+
+    while ((entry = readdir(dir)) != NULL) {
+        if (!is_numeric(entry->d_name)) {
+            continue;
+        }
+
+        int fd = atoi(entry->d_name);
+
+        // Do not touch stdin (0), stdout (1), stderr (2), or the DIR stream itself
+        if (fd == dir_fd) {
+            continue;
+        }
+
+        char path_buf[1024];
+        char link_target[1024] = { 0 };
+        snprintf(path_buf, sizeof(path_buf), "/proc/self/fd/%d", fd);
+
+        ssize_t len = readlink(path_buf, link_target, sizeof(link_target) - 1);
+        if (len != -1) {
+            link_target[len] = '\0';
+            printf("  FD %d -> %s\n", fd, link_target);
+        }
+        else {
+            printf("  FD %d -> [Unknown]\n", fd);
+        }
+
+        // Collect extra FDs (> 2, preserving stdio) excluding dir_fd
+        if (fd > 2 && fd != dir_fd && close_count < 256) {
+            fds_to_close[close_count++] = fd;
+        }
+    }
+
+    // 1. Close the directory stream safely FIRST
+    closedir(dir);
+
+    // 2. Now close all target descriptors cleanly without risking stream corruption
+    for (int i = 0; i < close_count; i++) {
+        int fd = fds_to_close[i];
+        // Shutdown sockets first to unblock any pending host network calls
+        shutdown(fd, SHUT_RDWR);
+        close(fd);
+        printf("[FD Cleanup] Explicitly closed lingering host FD %d\n", fd);
+    }
+
+    live_migration_teared_down = true;
+}
+
+uint32_t
+ptr_to_stack_offset(WASMExecEnv *exec_env, const void *ptr)
+{
+    uintptr_t bottom = (uintptr_t)exec_env->wasm_stack.bottom;
+    uintptr_t top = (uintptr_t)exec_env->wasm_stack.top;
+    uintptr_t p = (uintptr_t)ptr;
+
+    if (!ptr || p < bottom || p > top)
+        return LM_INVALID_OFFSET;
+
+    return (uint32_t)(p - bottom);
+}
+
+uint32_t
+ptr_to_func_code_offset(WASMFunctionInstance *func, const uint8 *ptr)
+{
+    uint8 *code = NULL;
+    uint8 *code_end = NULL;
+
+    if (!func || !ptr || func->is_import_func)
+        return LM_INVALID_OFFSET;
+
+    code = wasm_get_func_code(func);
+    code_end = wasm_get_func_code_end(func);
+
+    if (!code || !code_end || ptr < code || ptr > code_end)
+        return LM_INVALID_OFFSET;
+
+    return (uint32_t)(ptr - code);
+}
+
+static uint8 *
+func_code_offset_to_ptr(WASMFunctionInstance *func, uint32_t offset)
+{
+    uint8 *code = NULL;
+    uint8 *code_end = NULL;
+
+    if (!func || func->is_import_func || offset == LM_INVALID_OFFSET)
+        return NULL;
+
+    code = wasm_get_func_code(func);
+    code_end = wasm_get_func_code_end(func);
+
+    if (!code || !code_end || code + offset > code_end)
+        return NULL;
+
+    return code + offset;
+}
+
+#define LM_EOF_START 0x01
+#define LM_EOF_INITIAL 0x02
+#define LM_EOF_RECONSTRUCT 0x03
+#define LM_EOF_REPLAY 0x04
+#define LM_EOF_COMPLETE_SERVER 0x05
+#define LM_EOF_COMPLETE_CLIENT 0x06
+
+typedef enum { LM_TRANSFER_FILE, LM_TRANSFER_SOCKET } LMTransferType;
+
+typedef struct LMTransfer {
+    LMTransferType type;
+    union {
+        FILE *fp;
+        int fd;
+    } u;
+} LMTransfer;
+
+uint64_t get_time_in_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+double
+get_time_in_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1000000.0;
+}
+
+#define MEMBRANE_BUFFER_SIZE (128 * 1024 * 1024) // 128 MB
+
+static uint8_t *membrane_buffer = NULL;
+static size_t membrane_buffer_head = 0; // Write offset
+static bool membrane_buffer_initialized = false;
+
+// Define this globally in your server/migration state file
+static size_t host_generated_event_count = 0;
+
+// Define this statically near your buffer variables
+static uint32_t replayed_event_count = 0;
+
+/**
+ * Ensures the 128 MB software buffer is allocated on the heap.
+ */
+static void
+init_membrane_buffer(void)
+{
+    if (!membrane_buffer_initialized) {
+        membrane_buffer = (uint8_t *)malloc(MEMBRANE_BUFFER_SIZE);
+        if (!membrane_buffer) {
+            fprintf(stderr, "[LM/Checkpoint] CRITICAL: Failed to allocate 128 MB membrane software buffer!\n");
+            exit(1);
+        }
+        membrane_buffer_initialized = true;
+    }
+}
+
+static bool
+transfer_write(LMTransfer *t, const void *buf, size_t size)
+{
+    if (t->type == LM_TRANSFER_FILE) {
+        return fwrite(buf, 1, size, t->u.fp) == size;
+    }
+    const uint8 *p = (const uint8 *)buf;
+    while (size > 0) {
+        ssize_t res = send(t->u.fd, p, size, 0);
+        if (res <= 0) {
+            printf("[LM/Checkpoint] ERROR: result %lu, errno %i\n", res, errno);
+            if (errno == EINTR)
+                continue;
+            return false;
+        }
+        p += res;
+        size -= (size_t)res;
+    }
+    return true;
+}
+
+static bool
+transfer_read(LMTransfer *t, void *buf, size_t size)
+{
+    if (t->type == LM_TRANSFER_FILE) {
+        return fread(buf, 1, size, t->u.fp) == size;
+    }
+    else {
+        uint8 *p = (uint8 *)buf;
+        while (size > 0) {
+            ssize_t res = recv(t->u.fd, p, size, 0);
+            if (res <= 0) {
+                if (errno == EINTR)
+                    continue;
+                return false;
+            }
+            p += res;
+            size -= (size_t)res;
+        }
+        return true;
+    }
+}
+
+bool
+serialize_execution_frames(WASMExecEnv *exec_env, WASMModuleInstance *module_inst,
+                           LiveMigrationSerializedFrameStream *stream)
+{
+    WASMInterpFrame *frame;
+    stream->offset = 0; // Reset stream pointer
+
+    for (frame = exec_env->cur_frame; frame; frame = frame->prev_frame) {
+        LMFrameRecord rec;
+        uint32_t i;
+        WASMBranchBlock *block;
+        stream->count++;
+
+        memset(&rec, 0, sizeof(rec));
+
+        rec.frame_offset = ptr_to_stack_offset(exec_env, frame);
+        rec.prev_frame_offset = ptr_to_stack_offset(exec_env, frame->prev_frame);
+
+        if (frame->function && !frame->function->is_import_func) {
+            rec.function_index = (uint32_t)(frame->function - module_inst->e->functions);
+            rec.ip_offset = ptr_to_func_code_offset(frame->function, frame->ip);
+            if (rec.ip_offset == LM_INVALID_OFFSET && frame->ip) {
+                uint8 *code = wasm_get_func_code(frame->function);
+                uint8 *code_end = wasm_get_func_code_end(frame->function);
+                if (frame->ip >= code && frame->ip <= code_end) {
+                    rec.ip_offset = (uint32_t)(frame->ip - code);
+                }
+            }
+        }
+        else if (frame->function && frame->function->is_import_func) {
+            rec.function_index = (uint32_t)(frame->function - module_inst->e->functions);
+            rec.ip_offset = LM_INVALID_OFFSET; // Native functions do not have bytecode ip
+        }
+        else {
+            rec.function_index = LM_INVALID_OFFSET;
+            rec.ip_offset = LM_INVALID_OFFSET;
+        }
+
+        rec.sp_offset = ptr_to_stack_offset(exec_env, frame->sp);
+        rec.sp_bottom_offset = ptr_to_stack_offset(exec_env, frame->sp_bottom);
+        rec.sp_boundary_offset = ptr_to_stack_offset(exec_env, frame->sp_boundary);
+
+        rec.csp_offset = ptr_to_stack_offset(exec_env, frame->csp);
+        rec.csp_bottom_offset = ptr_to_stack_offset(exec_env, frame->csp_bottom);
+        rec.csp_boundary_offset = ptr_to_stack_offset(exec_env, frame->csp_boundary);
+
+        if (frame->csp && frame->csp_bottom && frame->csp >= frame->csp_bottom)
+            rec.active_csp_count = (uint32_t)(frame->csp - frame->csp_bottom);
+        else
+            rec.active_csp_count = 0;
+
+        // --- SAFE IN-MEMORY WRITE (No Network Blocking) ---
+        if (stream->offset + sizeof(rec) > sizeof(stream->buffer)) {
+            return false; // Buffer overflow protection
+        }
+        memcpy(stream->buffer + stream->offset, &rec, sizeof(rec));
+        stream->offset += sizeof(rec);
+
+        // Serialize Control Stack Blocks (CSP)
+        block = frame->csp_bottom;
+        for (i = 0; i < rec.active_csp_count; i++, block++) {
+            LMCSPRecord csp_rec;
+
+            csp_rec.frame_sp_offset = ptr_to_stack_offset(exec_env, block->frame_sp);
+
+            if (frame->function && !frame->function->is_import_func) {
+                csp_rec.begin_addr_offset = ptr_to_func_code_offset(frame->function, block->begin_addr);
+                csp_rec.target_addr_offset = ptr_to_func_code_offset(frame->function, block->target_addr);
+            }
+            else {
+                csp_rec.begin_addr_offset = LM_INVALID_OFFSET;
+                csp_rec.target_addr_offset = LM_INVALID_OFFSET;
+            }
+
+            if (stream->offset + sizeof(csp_rec) > sizeof(stream->buffer)) {
+                return false;
+            }
+            memcpy(stream->buffer + stream->offset, &csp_rec, sizeof(csp_rec));
+            stream->offset += sizeof(csp_rec);
+        }
+    }
+    return true;
+}
+
+static bool
+restore_state(wasm_exec_env_t exec_env, LMTransfer *t)
+{
+    WASMModuleInstance *module_inst;
+    uint32_t magic = 0;
+    uint32_t version = 0;
+
+    uint32_t linear_memory_data_size = 0;
+    uint8_t *new_linear_memory_base;
+
+    uint32_t stored_stack_size = 0;
+    uint32_t cur_frame_offset = LM_INVALID_OFFSET;
+    uintptr_t old_stack_bottom = 0;
+    uint8_t *new_stack_bottom;
+    intptr_t stack_delta;
+
+    uint32_t frame_count = 0;
+    uint32_t frame_i;
+
+    if (!exec_env) {
+        return false;
+    }
+
+    if (!transfer_read(t, &magic, sizeof(magic)) || !transfer_read(t, &version, sizeof(version))) {
+        printf("[LM/Restore] ERROR: Could not read migration prefix and version\n");
+        return false;
+    }
+
+    if (magic != LM_DUMP_MAGIC || version != LM_DUMP_VERSION) {
+        return false;
+    }
+
+    module_inst = (WASMModuleInstance *)wasm_runtime_get_module_inst(exec_env);
+    if (!module_inst || !module_inst->memories || !module_inst->memories[0]) {
+        printf("[LM/Restore] ERROR: Could load module\n");
+        return false;
+    }
+
+    if (!transfer_read(t, &stored_stack_size, sizeof(stored_stack_size))
+        || !transfer_read(t, &old_stack_bottom, sizeof(old_stack_bottom))) {
+        printf("[LM/Restore] ERROR: Could not read stack size\n");
+        return false;
+    }
+
+    if (stored_stack_size > exec_env->wasm_stack_size) {
+        printf("[LM/Restore] ERROR: Stack size does not match\n");
+        return false;
+    }
+
+    new_stack_bottom = exec_env->wasm_stack.bottom;
+
+    if (!transfer_read(t, new_stack_bottom, stored_stack_size)) {
+        printf("[LM/Restore] ERROR: Could not read new stack size\n");
+        return false;
+    }
+
+    exec_env->wasm_stack.top = new_stack_bottom + stored_stack_size;
+    stack_delta = (intptr_t)new_stack_bottom - (intptr_t)old_stack_bottom;
+
+    uint32_t stored_global_data_size = 0;
+    if (!transfer_read(t, &stored_global_data_size, sizeof(stored_global_data_size))) {
+        printf("[LM/Restore] ERROR: Could not read global data size\n");
+        return false;
+    }
+    if (stored_global_data_size > module_inst->global_data_size) {
+        printf("[LM/Restore] ERROR: Global data size from migration is too large\n");
+        return false;
+    }
+    printf("[LM/Restore] State metadata loaded\n");
+
+    if (!transfer_read(t, module_inst->global_data, stored_global_data_size)) {
+        printf("[LM/Restore] ERROR: Could not read global data\n");
+        return false;
+    }
+
+    new_linear_memory_base = module_inst->memories[0]->memory_data;
+    if (!transfer_read(t, &linear_memory_data_size, sizeof(linear_memory_data_size))) {
+        printf("[LM/Restore] ERROR: Could not read required linear memory size\n");
+        return false;
+    }
+
+    if (linear_memory_data_size > module_inst->memories[0]->memory_data_size) {
+        uint32_t current_memory_size = (uint32_t)module_inst->memories[0]->memory_data_size;
+        uint32_t needed_bytes = linear_memory_data_size - current_memory_size;
+        uint32_t inc_page_count = (needed_bytes + DEFAULT_NUM_BYTES_PER_PAGE - 1) / DEFAULT_NUM_BYTES_PER_PAGE;
+
+        if (!wasm_enlarge_memory(module_inst, inc_page_count)) {
+            printf("[LM/Restore] ERROR: Could not enlarge linear memory\n");
+            return false;
+        }
+        new_linear_memory_base = module_inst->memories[0]->memory_data;
+        printf("[LM/Restore] Had to enlarge linear memory for migration\n");
+    }
+
+    if (!transfer_read(t, new_linear_memory_base, linear_memory_data_size)) {
+        printf("[LM/Restore] ERROR: Could not read linear memory\n");
+        return false;
+    }
+    printf("[LM/Restore] Linear memory loaded\n");
+
+    if (!transfer_read(t, &cur_frame_offset, sizeof(cur_frame_offset))
+        || !transfer_read(t, &frame_count, sizeof(frame_count))) {
+        printf("[LM/Restore] ERROR: Could not read stack and shadow stack metadata\n");
+        return false;
+    }
+    exec_env->cur_frame = (struct WASMInterpFrame *)(new_stack_bottom + cur_frame_offset);
+    printf("[LM/Restore] Stack and shadow stack metadata loaded (frame count: %i, frame offset: %i)\n", frame_count,
+           cur_frame_offset);
+
+    for (frame_i = 0; frame_i < frame_count; frame_i++) {
+        LMFrameRecord rec;
+        WASMInterpFrame *frame;
+        WASMFunctionInstance *func = NULL;
+        uint32_t i;
+        WASMBranchBlock *block;
+
+        if (!transfer_read(t, &rec, sizeof(rec))) {
+            printf("[LM/Restore] ERROR: Could not load frame\n");
+            return false;
+        }
+
+        frame = (WASMInterpFrame *)(new_stack_bottom + rec.frame_offset);
+
+        if (rec.prev_frame_offset != LM_INVALID_OFFSET) {
+            frame->prev_frame = (WASMInterpFrame *)(new_stack_bottom + rec.prev_frame_offset);
+        }
+        else {
+            frame->prev_frame = NULL;
+        }
+
+        if (rec.function_index != LM_INVALID_OFFSET) {
+            func = module_inst->e->functions + rec.function_index;
+            frame->function = func;
+
+            if (func->is_import_func) {
+                // Native WASI frames do not have Wasm bytecode instructions
+                frame->ip = NULL;
+            }
+            else {
+                frame->ip = func_code_offset_to_ptr(func, rec.ip_offset);
+                if (!frame->ip && rec.ip_offset != LM_INVALID_OFFSET) {
+                    /* If offset is valid but ptr is NULL, it might be exactly at
+                       code_end. Allow it if it's within bounds. */
+                    uint8 *code = wasm_get_func_code(func);
+                    uint32 code_size = wasm_get_func_code_end(func) - code;
+                    if (rec.ip_offset <= code_size) {
+                        frame->ip = code + rec.ip_offset;
+                    }
+                }
+            }
+        }
+        else {
+            frame->function = NULL;
+            frame->ip = NULL;
+        }
+
+#define RESTORE_STACK_PTR(field, type)                                    \
+    do {                                                                  \
+        if (rec.field##_offset != LM_INVALID_OFFSET) {                    \
+            frame->field = (type)(new_stack_bottom + rec.field##_offset); \
+        }                                                                 \
+        else {                                                            \
+            frame->field = NULL;                                          \
+        }                                                                 \
+    } while (0)
+
+        RESTORE_STACK_PTR(sp, uint32 *);
+        RESTORE_STACK_PTR(sp_bottom, uint32 *);
+        RESTORE_STACK_PTR(sp_boundary, uint32 *);
+        RESTORE_STACK_PTR(csp, WASMBranchBlock *);
+        RESTORE_STACK_PTR(csp_bottom, WASMBranchBlock *);
+        RESTORE_STACK_PTR(csp_boundary, WASMBranchBlock *);
+
+#undef RESTORE_STACK_PTR
+
+        block = frame->csp_bottom;
+        for (i = 0; i < rec.active_csp_count; i++, block++) {
+            LMCSPRecord csp_rec;
+
+            if (!transfer_read(t, &csp_rec, sizeof(csp_rec))) {
+                printf("[LM/Restore] ERROR: Could not load shadow frame\n");
+                return false;
+            }
+
+            if (csp_rec.frame_sp_offset != LM_INVALID_OFFSET) {
+                block->frame_sp = (uint32 *)(new_stack_bottom + csp_rec.frame_sp_offset);
+            }
+            else {
+                block->frame_sp = NULL;
+            }
+
+            if (func && !func->is_import_func) {
+                block->begin_addr = func_code_offset_to_ptr(func, csp_rec.begin_addr_offset);
+                if (!block->begin_addr && csp_rec.begin_addr_offset != LM_INVALID_OFFSET) {
+                    uint8 *code = wasm_get_func_code(func);
+                    uint32 code_size = wasm_get_func_code_end(func) - code;
+                    if (csp_rec.begin_addr_offset <= code_size)
+                        block->begin_addr = code + csp_rec.begin_addr_offset;
+                }
+                block->target_addr = func_code_offset_to_ptr(func, csp_rec.target_addr_offset);
+                if (!block->target_addr && csp_rec.target_addr_offset != LM_INVALID_OFFSET) {
+                    uint8 *code = wasm_get_func_code(func);
+                    uint32 code_size = wasm_get_func_code_end(func) - code;
+                    if (csp_rec.target_addr_offset <= code_size)
+                        block->target_addr = code + csp_rec.target_addr_offset;
+                }
+            }
+            else {
+                block->begin_addr = NULL;
+                block->target_addr = NULL;
+            }
+        }
+    }
+
+    printf("[LM/Restore] State restored\n");
+    return true;
+}
+
+void
+live_migration_membrane_reset_memory_tracker(WASMMemoryInstance *memory_inst)
+{
+    (void)memory_inst; // Unused if tracking globally, but available if checking bounds
+
+    // Clear record count and wipe previous offsets
+    global_membrane_tracker.count = 0;
+    memset(global_membrane_tracker.records, 0, sizeof(global_membrane_tracker.records));
+}
+
+void
+live_migration_membrane_extract_mutations(WASMMemoryInstance *memory_inst, LiveMigrationMembraneEvent *ev)
+{
+    if (!memory_inst || !ev)
+        return;
+
+    ev->memory_offset = 0;
+    ev->payload_length = 0;
+
+    if (global_membrane_tracker.count == 0) {
+        return;
+    }
+
+    // ====================================================================
+    // AGGREGATE ALL RECORDED MEMORY ACCESSES FOR THIS SYSCALL!
+    // WAMR or the OS might chunk validations (e.g., two 64-byte blocks).
+    // ====================================================================
+    uint32_t min_offset = 0xFFFFFFFF;
+    uint32_t max_end = 0;
+
+    for (int i = 0; i < global_membrane_tracker.count; i++) {
+        uint32_t start = global_membrane_tracker.records[i].app_offset;
+        uint32_t end = start + global_membrane_tracker.records[i].length;
+
+        if (start < min_offset)
+            min_offset = start;
+        if (end > max_end)
+            max_end = end;
+    }
+
+    uint32_t offset = min_offset;
+    uint32_t len = max_end - min_offset;
+
+    // Bounds checking against WASM linear memory
+    if (offset + len > memory_inst->memory_data_size) {
+        if (offset < memory_inst->memory_data_size) {
+            len = memory_inst->memory_data_size - offset;
+        }
+        else {
+            return;
+        }
+    }
+
+    if (len > MEMBRANE_MAX_SIDE_EFFECT_BYTES) {
+        printf("[LM/Warning] Payload (%u) exceeds max (%d), truncating.\n", len, MEMBRANE_MAX_SIDE_EFFECT_BYTES);
+        len = MEMBRANE_MAX_SIDE_EFFECT_BYTES;
+    }
+
+    ev->memory_offset = offset;
+    ev->payload_length = len;
+    memcpy(ev->side_effect_payload, memory_inst->memory_data + offset, len);
+}
+
+bool
+live_migration_restore(wasm_exec_env_t exec_env, const char *filename)
+{
+    FILE *fp;
+    LMTransfer t;
+    bool ret;
+
+    if (!exec_env || !filename)
+        return false;
+
+    fp = fopen(filename, "rb");
+    if (!fp)
+        return false;
+
+    t.type = LM_TRANSFER_FILE;
+    t.u.fp = fp;
+
+    ret = restore_state(exec_env, &t);
+
+    fclose(fp);
+    return ret;
+}
+
+/**
+ * Probes the Linux kernel to find the active UDP socket for this WAMR process.
+ */
+void
+live_migration_capture_udp_state(LiveMigrationMetadata *meta)
+{
+    clock_t time_start = clock();
+
+    meta->active_udp_os_fd = live_migration_udp_dump.os_fd;
+    meta->active_udp_port = live_migration_udp_dump.port;
+
+    clock_t time_end = clock();
+    double duration = ((double)(time_end - time_start)) / CLOCKS_PER_SEC;
+    printf("[LM/Checkpoint] Capturing the UDP state took %f ms (fd: %i, port: %i)\n", duration * 1000.0,
+           live_migration_udp_dump.os_fd, live_migration_udp_dump.port);
+}
+
+/**
+ * Re-creates the UDP socket and clones it into the target OS FD slot.
+ */
+bool
+live_migration_restore_udp_socket(wasm_exec_env_t exec_env, int wasm_fd, uint16_t port)
+{
+    int target_os_fd = wasm_fd;
+    if (target_os_fd <= 0) {
+        return true; // No UDP socket was active
+    }
+
+    clock_t time_start = clock();
+
+    // 1. Create a fresh UDP socket (the OS will give it a random available FD, e.g., 8)
+    int new_sock = socket(AF_INET, SOCK_DGRAM, 0);
+    if (new_sock < 0) {
+        perror("[LM/Restore] Socket creation failed");
+        return false;
+    }
+
+    // 2. Allow port reuse (Critical if you are testing migrations rapidly)
+    int opt = 1;
+    setsockopt(new_sock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
+#ifdef SO_REUSEPORT
+    setsockopt(new_sock, SOL_SOCKET, SO_REUSEPORT, &opt, sizeof(opt));
+#endif
+
+    // 3. Bind it to the exact same port the WASM app is listening on
+    struct sockaddr_in addr = { 0 };
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = INADDR_ANY;
+    addr.sin_port = htons(port);
+
+    if (bind(new_sock, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+        perror("[LM/Restore] UDP bind failed");
+        close(new_sock);
+        return false;
+    }
+
+    clock_t time_end = clock();
+    double duration = ((double)(time_end - time_start)) / CLOCKS_PER_SEC;
+    printf("[LM/Restore] UDP Socket reconstituted on Port %u (Forced into OS FD: %d). Took %f ms\n", port, target_os_fd,
+           duration * 1000.0);
+
+    live_migration_udp_dump.os_fd = wasm_fd;
+    live_migration_udp_dump.port = port;
+
+    // 5. Update WAMR's internal WASI FD table to point to the new host FD
+    wasm_runtime_update_udp_fd(exec_env, wasm_fd, new_sock);
+
+    return true;
+}
+
+typedef struct {
+    wasm_exec_env_t exec_env;
+    int port;
+} MigrationServerArgs;
+
+LMTransfer migration_server_transfer;
+
+// Use volatile so the WASM execution thread instantly sees updates from the migration thread
+volatile bool live_migration_can_keep_flushing = false;
+
+/**
+ * Flushes the entire accumulated 128 MB software buffer over the TCP socket.
+ * Call this function right when execution halts for the final handover (0xEOF_RECONSTRUCT).
+ */
+bool
+live_migration_flush_membrane_buffer(void)
+{
+    if (!membrane_buffer_initialized || membrane_buffer_head == 0) {
+        return true; // Nothing to flush
+    }
+
+    bool success = transfer_write(&migration_server_transfer, membrane_buffer, membrane_buffer_head);
+
+    if (success) {
+        membrane_buffer_head = 0; // Reset write pointer after successful transmission
+    }
+    else {
+        printf("[LM/Checkpoint] ERROR: Failed to flush membrane buffer over TCP socket.\n");
+    }
+
+    return success;
+}
+
+#define FLUSH_INTERVAL_NS 500000
+#define NSEC_PER_SEC 1000000000
+#define BATCH_BUFFER_SIZE (64 * 1024 * 1024) // 64 MB per buffer
+
+// Two massive contiguous byte arrays pre-allocated on startup
+static uint8_t buffer_A[BATCH_BUFFER_SIZE];
+static uint8_t buffer_B[BATCH_BUFFER_SIZE];
+
+// Pointers to define which is active
+static uint8_t *active_wasm_buffer = buffer_A;
+static uint8_t *background_flush_buffer = buffer_B;
+
+static size_t active_wasm_offset = 0;
+static size_t background_flush_offset = 0;
+
+static pthread_mutex_t swap_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t membrane_flusher_thread_id;
+static volatile bool migration_active = false;
+
+static volatile size_t membrane_event_counter = 0;
+static size_t membrane_event_flush_counter = 0;
+
+static void
+flush_active_event_buffer(void)
+{
+    pthread_mutex_lock(&swap_mutex);
+
+    // 1. If there is nothing to send, unlock and return early
+    if (active_wasm_offset == 0) {
+        pthread_mutex_unlock(&swap_mutex);
+        return;
+    }
+
+    size_t migration_counter_local = membrane_event_counter;
+    size_t active_wasm_offset_local = active_wasm_offset;
+
+    // 2. Swap the buffer pointers! (The Ping-Pong)
+    uint8_t *temp_ptr = active_wasm_buffer;
+    active_wasm_buffer = background_flush_buffer;
+    background_flush_buffer = temp_ptr;
+
+    // 3. Save the amount of data we need to send, then reset the active offset for WASM
+    background_flush_offset = active_wasm_offset;
+    active_wasm_offset = 0;
+    membrane_event_counter = 0;
+
+    // 4. Drop the lock immediately! The WASM thread is now writing to the fresh buffer.
+    pthread_mutex_unlock(&swap_mutex);
+
+    membrane_event_flush_counter++;
+    if (membrane_event_flush_counter % 100 == 0) {
+        printf("[LM/Checkpoint] Batched %lu events in %lu bytes\n", migration_counter_local, active_wasm_offset_local);
+    }
+
+    // 5. Do the slow network write from the background buffer
+    // (This is completely lock-free and doesn't block the WASM thread at all)
+    transfer_write(&migration_server_transfer, background_flush_buffer,
+                   background_flush_offset);
+}
+
+void *
+membrane_flusher_thread(void *arg)
+{
+    struct timespec next_wakeup;
+    (void)arg;
+
+    // 1. Get the current monotonic time to anchor our absolute timeline
+    clock_gettime(CLOCK_MONOTONIC, &next_wakeup);
+
+    while (migration_active) {
+        // 2. Calculate the exact time for the next wake-up
+        next_wakeup.tv_nsec += FLUSH_INTERVAL_NS;
+
+        // 3. Handle nanosecond overflow (rollover to the next second)
+        if (next_wakeup.tv_nsec >= NSEC_PER_SEC) {
+            next_wakeup.tv_nsec -= NSEC_PER_SEC;
+            next_wakeup.tv_sec += 1;
+        }
+
+        // 4. Sleep until the absolute target time is reached
+        clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &next_wakeup, NULL);
+
+        // 5. Do the actual batch flush logic here
+        flush_active_event_buffer();
+    }
+
+    // Ensure any remaining events are flushed synchronously when migration stops
+    flush_active_event_buffer();
+
+    return NULL;
+}
+
+static void *
+migration_server_thread(void *arg)
+{
+    MigrationServerArgs *args = (MigrationServerArgs *)arg;
+    wasm_exec_env_t exec_env = args->exec_env;
+    int port = args->port;
+    int listen_fd = -1, client_fd = -1;
+    struct sockaddr_in serv_addr;
+    LMTransfer t;
+    WASMModuleInstance *module_inst;
+    WASMMemoryInstance *memory;
+    uint8 flag;
+
+    wasm_runtime_free(args);
+
+    module_inst = (WASMModuleInstance *)wasm_runtime_get_module_inst(exec_env);
+    if (!module_inst || !module_inst->memories || !module_inst->memories[0]) {
+        return NULL;
+    }
+    memory = module_inst->memories[0];
+
+    //////////////////////////////////////////////////////////////////////////
+    ///                                                                    ///
+    /// PHASE 0: Waiting for a migration client to connect.                ///
+    ///                                                                    ///
+    //////////////////////////////////////////////////////////////////////////
+
+    listen_fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (listen_fd < 0)
+        return NULL;
+
+    int opt = 1;
+    setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
+    setsockopt(listen_fd, IPPROTO_TCP, TCP_NODELAY, (char *)&opt, sizeof(opt));
+
+    serv_addr.sin_family = AF_INET;
+    serv_addr.sin_addr.s_addr = INADDR_ANY;
+    serv_addr.sin_port = htons(port);
+
+    if (bind(listen_fd, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
+        close(listen_fd);
+        return NULL;
+    }
+
+    if (listen(listen_fd, 1) < 0) {
+        close(listen_fd);
+        return NULL;
+    }
+
+    printf("[LM] Server waiting for connection on port %d...\n", port);
+    client_fd = accept(listen_fd, NULL, NULL);
+    if (client_fd < 0) {
+        close(listen_fd);
+        return NULL;
+    }
+
+    //////////////////////////////////////////////////////////////////////////
+    ///                                                                    ///
+    /// PHASE 1: Perform the bulk migration of the linear memory.          ///
+    ///                                                                    ///
+    //////////////////////////////////////////////////////////////////////////
+
+    printf("[LM] Client connected. Migration is initiated (%f ms)...\n", get_time_in_ms());
+    exec_env->live_migrating = true;
+
+    int side_port = port + 1;
+    int side_listen_fd = -1, side_client_fd = -1;
+    struct sockaddr_in side_serv_addr;
+
+    t.type = LM_TRANSFER_SOCKET;
+    t.u.fd = client_fd;
+
+    side_listen_fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (side_listen_fd >= 0) {
+        int side_opt = 1;
+        int huge_buf = 4 * 1024 * 1024;
+        setsockopt(side_listen_fd, SOL_SOCKET, SO_REUSEADDR, &side_opt, sizeof(side_opt));
+        setsockopt(side_listen_fd, IPPROTO_TCP, TCP_NODELAY, (char *)&side_opt, sizeof(int));
+        setsockopt(side_listen_fd, SOL_SOCKET, SO_SNDBUF, &huge_buf, sizeof(huge_buf));
+
+        side_serv_addr.sin_family = AF_INET;
+        side_serv_addr.sin_addr.s_addr = INADDR_ANY;
+        side_serv_addr.sin_port = htons(side_port);
+
+        if (bind(side_listen_fd, (struct sockaddr *)&side_serv_addr, sizeof(side_serv_addr)) >= 0
+            && listen(side_listen_fd, 1) >= 0) {
+            printf("[LM/Checkpoint] Server waiting for membrane connection on port %d...\n", side_port);
+            flag = LM_EOF_START;
+            if (!transfer_write(&t, &flag, sizeof(flag))) {
+                printf("[LM/Checkpoint] Ready to start migration...\n");
+                goto fail;
+            }
+            side_client_fd = accept(side_listen_fd, NULL, NULL);
+            setsockopt(side_client_fd, IPPROTO_TCP, TCP_NODELAY, (char *)&side_opt, sizeof(int));
+        }
+
+        if (side_client_fd >= 0) {
+            migration_server_transfer.type = LM_TRANSFER_SOCKET;
+            migration_server_transfer.u.fd = side_client_fd;
+            printf("[LM/Checkpoint] Membrane channel connected on port %d\n", side_port);
+
+            // Start the flusher thread
+            migration_active = true;
+            if (pthread_create(&membrane_flusher_thread_id, NULL, membrane_flusher_thread, NULL) != 0) {
+                printf("[LM/Checkpoint] ERROR: Failed to spawn membrane flusher thread!\n");
+                migration_active = false;
+            }
+        }
+    }
+
+    /* Phase 1: Initial Bulk Transmission */
+    clock_t phase_1_start = clock();
+    double migration_start_time = get_time_in_ms();
+
+    // Wait until all frames are synchronized by the main thread...
+    exec_env->live_migration_sync_stack = true;
+    while (exec_env->live_migration_sync_stack) {
+        os_usleep(1000);
+    }
+    exec_env->live_migration_sync = true;
+    printf("[LM/Checkpoint] Memory snapshot captured after %f ms\n", get_time_in_ms() - migration_start_time);
+
+    uint32_t migration_magic_prefix = LM_DUMP_MAGIC;
+    uint32_t migration_version = LM_DUMP_VERSION;
+
+    uint32_t stack_size = (uint32_t)(exec_env->wasm_stack.top - exec_env->wasm_stack.bottom);
+    uintptr_t old_stack_bottom = (uintptr_t)exec_env->wasm_stack.bottom;
+    uint32_t global_data_size = module_inst->global_data_size;
+
+    printf("[LM/Checkpoint] Phase 1.1: Sending state metadata...\n");
+    double metadata_send_start = get_time_in_ms();
+
+    if (!transfer_write(&t, &migration_magic_prefix, sizeof(migration_magic_prefix))
+        || !transfer_write(&t, &migration_version, sizeof(migration_version))
+        || !transfer_write(&t, &stack_size, sizeof(stack_size))
+        || !transfer_write(&t, &old_stack_bottom, sizeof(old_stack_bottom))
+        || !transfer_write(&t, exec_env->wasm_stack.bottom, stack_size)
+        || !transfer_write(&t, &global_data_size, sizeof(global_data_size))
+        || !transfer_write(&t, module_inst->global_data, global_data_size)) {
+        printf("[LM/Checkpoint] ERROR: Failed to metadata to stream.\n");
+        goto fail;
+    }
+
+    printf("[LM/Checkpoint] Memory metadata transmitted after %f ms\n", get_time_in_ms() - metadata_send_start);
+
+    live_migration_membrane_mode = LIVE_MIGRATION_MODE_RECORD;
+    exec_env->live_migration_sync = false;
+
+    double memory_start_time = get_time_in_ms();
+
+    uint32_t linear_memory_data_size = exec_env->live_migration_linear_memory_snapshot_size;
+    uint32_t in_mb = linear_memory_data_size / (1024 * 1024);
+    memory = module_inst->memories[0];
+
+    if (in_mb <= 0) {
+        printf("[LM/Checkpoint] Phase 1.2: Sending initial bulk memory (%u KB)...\n", linear_memory_data_size / 1024);
+    }
+    else {
+        printf("[LM/Checkpoint] Phase 1.2: Sending initial bulk memory (%u MB)...\n", in_mb);
+    }
+
+    if (!transfer_write(&t, &linear_memory_data_size, sizeof(linear_memory_data_size))) {
+        printf("[LM/Checkpoint] ERROR: Failed to write linear memory size to stream.\n");
+        goto fail;
+    }
+
+    if (memory->mem_fd >= 0) {
+        // Option A: Use sendfile if the stream is a socket
+        // Option B: Just use the CoW mapping (it is already in exec_env->live_migration_linear_memory_snapshot)
+        if (!transfer_write(&t, exec_env->live_migration_linear_memory_snapshot, linear_memory_data_size)) {
+            printf("[LM/Checkpoint] ERROR: Failed to write linear memory CoW snapshot to stream.\n");
+            goto fail;
+        }
+    }
+    else {
+        if (!transfer_write(&t, exec_env->live_migration_linear_memory_snapshot, linear_memory_data_size)) {
+            printf("[LM/Checkpoint] ERROR: Failed to write linear memory snapshot to stream.\n");
+            goto fail;
+        }
+    }
+
+    printf("[LM/Checkpoint] Linear memory transmitted after %f ms\n", get_time_in_ms() - memory_start_time);
+
+    //////////////////////////////////////////////////////////////////////////
+    ///                                                                    ///
+    /// PHASE 1.1: Synchronize Stack and Shadow Frames and Write them out. ///
+    ///                                                                    ///
+    //////////////////////////////////////////////////////////////////////////
+
+    // Wait until all frames are synchronized by the main thread...
+
+    double frames_start_time = get_time_in_ms();
+    uint32_t cur_frame_offset = exec_env->serialized_frame_stream.current_frame_offset;
+    uint32_t frame_count = exec_env->serialized_frame_stream.count;
+
+    // ...to then write it out
+    if (!transfer_write(&t, &cur_frame_offset, sizeof(cur_frame_offset))
+        || !transfer_write(&t, &frame_count, sizeof(frame_count))
+        || !transfer_write(&t, exec_env->serialized_frame_stream.buffer, exec_env->serialized_frame_stream.offset)) {
+        printf("[LM/Checkpoint] Could write stack and shadow stack frames to migration stream.\n");
+        goto fail;
+    }
+    printf("[LM/Checkpoint] Wrote stack and shadow stack frames to stream (frame count: %i, frame offset: %i)\n",
+           frame_count, cur_frame_offset);
+
+    // Signal the migration client that initial state has been synchronized
+    flag = LM_EOF_INITIAL;
+    if (!transfer_write(&t, &flag, sizeof(flag))) {
+        goto fail;
+    }
+
+    printf("[LM/Checkpoint] Frames transmitted after %f ms\n", get_time_in_ms() - frames_start_time);
+
+    // Set migrating flag so the interpreter loop knows we're in the final phase
+    exec_env->live_migrating = true;
+
+    LiveMigrationMetadata metadata = { 0 };
+    live_migration_capture_udp_state(&metadata);
+
+    if (!transfer_write(&t, &metadata, sizeof(LiveMigrationMetadata))) {
+        printf("[LM/Checkpoint] ERROR: Could not send migration metadata.");
+        goto fail;
+    }
+
+    //////////////////////////////////////////////////////////////////////////
+    ///                                                                    ///
+    /// PHASE 2: Write out the replay log of the membrane                  ///
+    ///                                                                    ///
+    //////////////////////////////////////////////////////////////////////////
+
+    clock_t phase_1_end = clock();
+    double phase_1_dur = ((double)(phase_1_end - phase_1_start)) / CLOCKS_PER_SEC;
+    double membrane_start_time = get_time_in_ms();
+    printf("[LM/Checkpoint] Initial full linear memory handover duration %f ms\n", phase_1_dur * 1000.0);
+
+    /* Phase 2: Incremental Chase */
+    /* 3. Wait for 0xEOF_RECONSTRUCT */
+    if (!transfer_read(&t, &flag, sizeof(flag)) || flag != LM_EOF_RECONSTRUCT) {
+        goto fail;
+    }
+
+    printf("[LM/Checkpoint] Flushing %zu bytes of buffered membrane events...\n", membrane_buffer_head);
+
+    live_migration_can_keep_flushing = true;
+
+    printf("[LM/Checkpoint] Received 0xEOF_RECONSTRUCT, halting execution for final handover (%f ms)...\n",
+           get_time_in_ms());
+
+    /* 4. Send 0xEOF_COMPLETE */
+    flag = LM_EOF_COMPLETE_SERVER;
+    if (!transfer_write(&t, &flag, sizeof(flag))) {
+        printf("[LM/Checkpoint] ERROR: Could not write LM_EOF_COMPLETE_SERVER flag (%f ms)\n", get_time_in_ms());
+        goto fail;
+    }
+
+    printf("[LM/Checkpoint] Migration server completed its tasks\n");
+
+    if (!transfer_read(&t, &flag, sizeof(flag)) || flag != LM_EOF_COMPLETE_CLIENT) {
+        printf("[LM/Checkpoint] ERROR: Could not read LM_EOF_COMPLETE_CLIENT flag (%f ms)\n", get_time_in_ms());
+        goto fail;
+    }
+
+    printf("[LM/Checkpoint] Initial membrane chunk transmitted after %f ms\n", get_time_in_ms() - membrane_start_time);
+
+    // =====================================================================
+    // DYNAMIC CONVERGENCE LOOP
+    // =====================================================================
+    // Give it a bit of time to settle and transmit the first membrane events if necessary
+    os_usleep(10000);
+
+    uint32_t last_client_ack_seq = 0;
+    const uint32_t CONVERGENCE_THRESHOLD = 250;
+
+    // Capture the start time
+    double convergence_start_time = get_time_in_ms();
+    const double MAX_CONVERGENCE_TIME_MS = 20000.0;
+
+    printf("[LM/Checkpoint] Trying to converge membrane replay log...\n");
+    while (true) {
+        uint32_t ack_buf = 0;
+        ssize_t bytes_read = recv(side_client_fd, &ack_buf, sizeof(ack_buf), MSG_DONTWAIT);
+
+        if (bytes_read > 0) {
+            last_client_ack_seq = ack_buf;
+        }
+
+        uint32_t current_lag = host_generated_event_count - last_client_ack_seq;
+        double elapsed_time = get_time_in_ms() - convergence_start_time;
+
+        // Condition 1: Natural Convergence (Happy Path)
+        if (current_lag <= CONVERGENCE_THRESHOLD) {
+            printf("[LM/Checkpoint] Converged naturally! Lag: %u events (%f ms).\n", current_lag, elapsed_time);
+            break;
+        }
+
+        // Condition 2: Forced Cutover (Fallback Path)
+        if (elapsed_time > MAX_CONVERGENCE_TIME_MS) {
+            printf("[LM/Checkpoint] WARNING: Forced cutover triggered. Lag is still %u events, but max time (%f ms) "
+                   "exceeded.\n",
+                   current_lag, elapsed_time);
+            break; // Break the loop and force the halt anyway
+        }
+
+        os_usleep(500);
+    }
+
+    // Give it a bit more time to settle
+    live_migration_membrane_mode = LIVE_MIGRATION_MODE_DISABLED;
+
+    printf("[LM/Checkpoint] Migration client completed its tasks\n");
+
+    exec_env->live_migrating = true;
+    exec_env->live_migration_complete = true;
+
+    // Set termination flag so the interpreter loop exits as soon as it reaches the next opcode
+    WASM_SUSPEND_FLAGS_FETCH_OR(exec_env->suspend_flags, WASM_SUSPEND_FLAG_TERMINATE);
+
+    migration_active = false;
+    pthread_join(membrane_flusher_thread_id, NULL);
+    printf("[LM/Checkpoint] Transmitted %lu membrane events\n", host_generated_event_count);
+
+    double migration_complete_time = get_time_in_ms();
+    printf("[LM/Checkpoint] Migration completed in %f ms\n", migration_complete_time - migration_start_time);
+    printf("[LM/Checkpoint] Live migration completed at %f ms.\n", migration_complete_time);
+
+fail:
+    printf("[LM/Checkpoint] Closing migration connections...\n");
+    if (client_fd >= 0)
+        close(client_fd);
+    if (listen_fd >= 0)
+        close(listen_fd);
+    if (side_client_fd >= 0)
+        close(side_client_fd);
+    if (side_listen_fd >= 0)
+        close(side_listen_fd);
+    printf("[LM/Checkpoint] Closed all migration connections!\n");
+    alarm(1);
+    return NULL;
+}
+
+bool
+live_migration_server(wasm_exec_env_t exec_env, int port)
+{
+    MigrationServerArgs *args;
+    korp_tid tid;
+
+    args = wasm_runtime_malloc(sizeof(MigrationServerArgs));
+    if (!args)
+        return false;
+
+    args->exec_env = exec_env;
+    args->port = port;
+
+    if (os_thread_create(&tid, migration_server_thread, args, APP_THREAD_STACK_SIZE_DEFAULT) != 0) {
+        wasm_runtime_free(args);
+        return false;
+    }
+
+    return true;
+}
+
+LMTransfer migration_client_transfer;
+LiveMigrationMetadata migration_client_metadata;
+bool live_migration_upd_restored = false;
+int side_sock_fd = -1;
+
+void
+close_side_sock()
+{
+    if (side_sock_fd >= 0) {
+        close(side_sock_fd);
+        printf("[LM/Restore] Closed side sock fd %i\n", side_sock_fd);
+        side_sock_fd = -1;
+    }
+}
+
+// Allocate enough space for 2 million events (approx. 64MB - 128MB depending on struct size)
+#define CLIENT_MEMBRANE_BUFFER_EVENTS (2 * 1024 * 1024)
+
+static LiveMigrationMembraneEvent *client_membrane_buffer[CLIENT_MEMBRANE_BUFFER_EVENTS];
+static size_t client_buf_head = 0;  // Write index (Background Thread)
+static size_t client_buf_tail = 0;  // Read index (WASM Thread)
+static size_t client_buf_count = 0; // Number of events currently in buffer
+static size_t client_buf_total_count = 0;
+static bool client_network_closed = false;
+
+static pthread_mutex_t client_buf_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t client_buf_cond = PTHREAD_COND_INITIALIZER;
+static pthread_t membrane_reader_thread;
+
+/**
+ * Background worker thread that constantly drains the TCP socket
+ * and pushes events into the heap-allocated ring buffer.
+ */
+static void *
+membrane_reader_worker(void *arg)
+{
+    LMTransfer *t = (LMTransfer *)arg;
+
+    while (true) {
+        LiveMigrationMembraneEvent header;
+
+        // 1. Block and read ONLY the fixed header from the socket
+        if (!transfer_read(t, &header, sizeof(LiveMigrationMembraneEvent))) {
+            // EOF received or socket error: Sat 1 dropped connection
+            pthread_mutex_lock(&client_buf_mutex);
+            client_network_closed = true;
+            pthread_cond_signal(&client_buf_cond);
+            pthread_mutex_unlock(&client_buf_mutex);
+            break;
+        }
+
+        // 2. Allocate exact memory needed for this specific event (Header + Payload)
+        size_t total_size = sizeof(LiveMigrationMembraneEvent) + header.payload_length;
+        LiveMigrationMembraneEvent *ev = (LiveMigrationMembraneEvent *)malloc(total_size);
+
+        // Copy the header we just read into our allocated memory
+        memcpy(ev, &header, sizeof(LiveMigrationMembraneEvent));
+
+        // 3. If there is a payload, read it directly into the allocated flexible array
+        if (header.payload_length > 0) {
+            if (!transfer_read(t, ev->side_effect_payload, header.payload_length)) {
+                free(ev); // Clean up if socket fails mid-read
+                break;
+            }
+        }
+
+        client_buf_total_count++;
+
+        // 4. Lock buffer and insert the POINTER
+        pthread_mutex_lock(&client_buf_mutex);
+        if (client_buf_count < CLIENT_MEMBRANE_BUFFER_EVENTS) {
+            client_membrane_buffer[client_buf_head] = ev; // Store pointer
+            client_buf_head = (client_buf_head + 1) % CLIENT_MEMBRANE_BUFFER_EVENTS;
+            client_buf_count++;
+
+            // Wake up the consumer thread if it was waiting for data
+            pthread_cond_signal(&client_buf_cond);
+        }
+        else {
+            printf("[LM/Restore] CRITICAL: Client membrane buffer overflow! Dropping event.\n");
+            free(ev); // Prevent memory leak on overflow
+        }
+        pthread_mutex_unlock(&client_buf_mutex);
+    }
+
+    return NULL;
+}
+
+bool
+live_migration_client(wasm_exec_env_t exec_env, const char *host, int port)
+{
+    int sock_fd;
+    struct sockaddr_in serv_addr;
+    struct hostent *server;
+    LMTransfer t;
+    WASMModuleInstance *module_inst;
+    WASMMemoryInstance *memory;
+    uint8 flag;
+    uint32 memory_data_size;
+
+    module_inst = (WASMModuleInstance *)wasm_runtime_get_module_inst(exec_env);
+    if (!module_inst || !module_inst->memories || !module_inst->memories[0]) {
+        printf("[LM/Restore] ERROR: Could not load module instance.\n");
+        return false;
+    }
+    memory = module_inst->memories[0];
+
+    sock_fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (sock_fd < 0) {
+        printf("[LM/Restore] ERROR: Could not instantiate socket instance.\n");
+        return false;
+    }
+
+    serv_addr.sin_family = AF_INET;
+    serv_addr.sin_port = htons(port);
+    server = gethostbyname(host);
+    if (server == NULL) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: No such host %s\n", host);
+        return false;
+    }
+    memcpy(&serv_addr.sin_addr.s_addr, server->h_addr, server->h_length);
+
+    if (connect(sock_fd, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: Connection issue\n");
+        return false;
+    }
+    printf("[LM/Restore] Connected to migration server %s:%d\n", host, port);
+
+    t.type = LM_TRANSFER_SOCKET;
+    t.u.fd = sock_fd;
+
+    if (!transfer_read(&t, &flag, sizeof(flag)) || flag != LM_EOF_START) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: Cannot read LM_EOF_START flag.\n");
+        return false;
+    }
+
+    int side_port = port + 1;
+    close_side_sock();
+    side_sock_fd = socket(AF_INET, SOCK_STREAM, 0);
+
+    if (side_sock_fd >= 0) {
+        struct sockaddr_in side_serv_addr;
+        side_serv_addr.sin_family = AF_INET;
+        side_serv_addr.sin_port = htons(side_port);
+        memcpy(&side_serv_addr.sin_addr.s_addr, server->h_addr, server->h_length);
+
+        if (connect(side_sock_fd, (struct sockaddr *)&side_serv_addr, sizeof(side_serv_addr)) >= 0) {
+
+            // Optional: Also set TCP_NODELAY if you haven't already to keep it fast
+            int sock_flag = 1;
+            setsockopt(side_sock_fd, IPPROTO_TCP, TCP_NODELAY, (char *)&sock_flag, sizeof(int));
+
+            migration_client_transfer.type = LM_TRANSFER_SOCKET;
+            migration_client_transfer.u.fd = side_sock_fd;
+            printf("[LM/Restore] Membrane channel connected to %s:%d\n", host, side_port);
+
+            // Reset buffer state for new migration
+            client_buf_head = 0;
+            client_buf_tail = 0;
+            client_buf_count = 0;
+            client_network_closed = false;
+
+            // Start draining the socket immediately
+            if (pthread_create(&membrane_reader_thread, NULL, membrane_reader_worker, &migration_client_transfer)
+                != 0) {
+                printf("[LM/Restore] CRITICAL: Failed to spawn membrane reader thread!\n");
+                return false;
+            }
+        }
+        else {
+            close(side_sock_fd);
+            printf("[LM/Restore] ERROR: Could not connect to membrane channel %s:%d\n", host, side_port);
+        }
+    }
+
+    /* Phase 1 & 2: Client side */
+    /* 1. Receive initial memory */
+    if (!restore_state(exec_env, &t)) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: Cannot read initial block\n");
+        return false;
+    }
+
+    /* 4. Receive 0xEOF_INITIAL */
+    if (!transfer_read(&t, &flag, sizeof(flag)) || flag != LM_EOF_INITIAL) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: Cannot read LM_EOF_INITIAL flag.\n");
+        return false;
+    }
+
+    if (!transfer_read(&t, &migration_client_metadata, sizeof(LiveMigrationMetadata))) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: Cannot read live migration metadata.\n");
+        return false;
+    }
+
+    printf("[LM/Restore] Initial state has been reconstructed (%f ms).\n", get_time_in_ms());
+
+    live_migration_upd_restored = live_migration_restore_udp_socket(
+        exec_env, migration_client_metadata.active_udp_os_fd, migration_client_metadata.active_udp_port);
+
+    if (!live_migration_upd_restored) {
+        printf("[LM/Restore] ERROR: Could not restore UDP socket yet. Will try again later...\n");
+    }
+
+    /* 2. Write back 0xEOF_RECONSTRUCT */
+    flag = LM_EOF_RECONSTRUCT;
+    if (!transfer_write(&t, &flag, sizeof(flag))) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: Cannot write LM_EOF_RECONSTRUCT flag.\n");
+        return false;
+    }
+
+    live_migration_membrane_mode = LIVE_MIGRATION_MODE_REPLAY;
+    printf("[LM/Restore] Enter membrane replay mode (%f ms)...\n", get_time_in_ms());
+
+    /* 6. Receive 0xEOF_COMPLETE */
+    if (!transfer_read(&t, &flag, sizeof(flag)) || flag != LM_EOF_COMPLETE_SERVER) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: Cannot read LM_EOF_COMPLETE_SERVER flag.\n");
+        return false;
+    }
+    printf("[LM/Checkpoint] Migration server completed its tasks (%f ms)\n", get_time_in_ms());
+
+    flag = LM_EOF_COMPLETE_CLIENT;
+    if (!transfer_write(&t, &flag, sizeof(flag))) {
+        close(sock_fd);
+        printf("[LM/Restore] ERROR: Cannot write LM_EOF_COMPLETE_CLIENT flag.\n");
+        return false;
+    }
+    printf("[LM/Checkpoint] Migration client completed its tasks (%f ms)\n", get_time_in_ms());
+
+    close(sock_fd);
+    return true;
+}
+
+/**
+ * Fetches the next MembraneEvent from the internal thread-safe buffer.
+ */
+bool
+live_migration_fetch_membrane_event(WASMExecEnv *exec_env, LiveMigrationMembraneEvent **ev)
+{
+    if (!ev || migration_client_transfer.type != LM_TRANSFER_SOCKET) {
+        return false;
+    }
+
+    pthread_mutex_lock(&client_buf_mutex);
+
+    while (client_buf_count == 0 && !client_network_closed) {
+        pthread_cond_wait(&client_buf_cond, &client_buf_mutex);
+    }
+
+    if (client_buf_count > 0) {
+        // Retrieve the pointer from the ring buffer
+        *ev = client_membrane_buffer[client_buf_tail];
+        client_buf_tail = (client_buf_tail + 1) % CLIENT_MEMBRANE_BUFFER_EVENTS;
+        client_buf_count--;
+
+        pthread_mutex_unlock(&client_buf_mutex);
+
+        replayed_event_count++;
+        if (replayed_event_count % 10 == 0) {
+            send(migration_client_transfer.u.fd, &replayed_event_count, sizeof(replayed_event_count), MSG_DONTWAIT);
+        }
+        return true;
+    }
+
+    // If we reach this point, the buffer is entirely empty AND the connection is closed.
+    pthread_mutex_unlock(&client_buf_mutex);
+
+    // =====================================================================
+    // CUTOVER TRIGGER: Replay Log Exhausted (Sat 1 dropped connection)
+    // =====================================================================
+    close_side_sock();
+
+    // Ensure we join the background thread safely so it doesn't leak
+    pthread_join(membrane_reader_thread, NULL);
+
+    if (!live_migration_upd_restored && migration_client_metadata.active_udp_os_fd >= 0) {
+        printf("[LM/Restore] Restore UDP socket connection (fd: %i, %f ms)\n",
+               migration_client_metadata.active_udp_os_fd, get_time_in_ms());
+        live_migration_upd_restored = live_migration_restore_udp_socket(
+            exec_env, migration_client_metadata.active_udp_os_fd, migration_client_metadata.active_udp_port);
+
+        if (!live_migration_upd_restored) {
+            printf("[LM/Restore] ERROR: Cannot restore UDP socket.\n");
+            return false;
+        }
+    }
+
+    // Automatically transition Sat 2 to live execution
+    live_migration_membrane_mode = LIVE_MIGRATION_MODE_DISABLED;
+
+    printf("[LM/Restore] Read %lu membrane events\n", client_buf_total_count);
+    printf("[LM/Restore] Live migration restored at %f ms\n", get_time_in_ms());
+
+    return false;
+}
+
+bool
+live_migration_write_membrane_event(WASMExecEnv *exec_env, const LiveMigrationMembraneEvent *ev)
+{
+    if (!ev || live_migration_teared_down || migration_server_transfer.type != LM_TRANSFER_SOCKET) {
+        return false;
+    }
+
+    size_t event_size = sizeof(LiveMigrationMembraneEvent) + ev->payload_length;
+
+    pthread_mutex_lock(&swap_mutex);
+
+    // Ensure we don't overflow the 2MB buffer
+    if (active_wasm_offset + event_size > BATCH_BUFFER_SIZE) {
+        pthread_mutex_unlock(&swap_mutex);
+        printf("[LM/Checkpoint] CRITICAL: Double-buffer full! Increase size or flush faster.\n");
+        return false;
+    }
+
+    // 1. Copy the bytes directly into the pre-allocated contiguous array
+    memcpy(active_wasm_buffer + active_wasm_offset, ev, event_size);
+
+    // 2. Advance the offset
+    active_wasm_offset += event_size;
+    membrane_event_counter++;
+
+    pthread_mutex_unlock(&swap_mutex);
+
+    // Track total generated events for the convergence check
+    host_generated_event_count++;
+    if (host_generated_event_count % 10000 == 0) {
+        printf("[LM/Checkpoint] SAMPLE: Sent membrane event of size %lu byte (%u bytes of payload)\n", event_size,
+               ev->payload_length);
+    }
+
+    return true;
+}
+
+bool
+wasm_live_migration_server(wasm_exec_env_t exec_env, int port)
+{
+    return live_migration_server(exec_env, port);
+}
+
+bool
+wasm_live_migration_client(wasm_exec_env_t exec_env, const char *host, int port)
+{
+    return live_migration_client(exec_env, host, port);
+}
