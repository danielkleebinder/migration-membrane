+static void
+watchdog_alarm_handler(int sig)
+{
+    // Note: Keep operations inside signal handlers async-signal-safe where possible.
+    // write() and _exit() are strictly async-signal-safe.
+    const char msg[] = "\n[Watchdog] Timeout reached! Forcibly shutting down runtime...\n";
+    write(STDERR_FILENO, msg, sizeof(msg) - 1);
+
+    tear_down_live_migration();
+
+    // Use _exit() instead of exit() inside a signal handler to avoid double-flushing stdio
+    _exit(EXIT_FAILURE);
+}
+
+void
+setup_watchdog()
+{
+    struct sigaction sa;
+    sa.sa_handler = watchdog_alarm_handler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0; // Or SA_RESTART if you don't want system calls interrupted
+
+    if (sigaction(SIGALRM, &sa, NULL) < 0) {
+        perror("[Watchdog] Failed to register SIGALRM handler");
+    }
+}
