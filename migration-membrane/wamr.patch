+#if WASM_ENABLE_LIVE_MIGRATION != 0
+bool
+live_migration_resume(wasm_exec_env_t exec_env, clock_t benchmark_start)
+{
+    WASMExecEnv *exec_env_internal = (WASMExecEnv *)exec_env;
+    WASMInterpFrame *cur_frame;
+    WASMModuleInstance *module_inst;
+    bool resuming_native = false;
+    WASMFunctionInstance *native_func = NULL;
+
+    if (!exec_env_internal || !exec_env_internal->cur_frame) {
+        printf("[LM/Resume] Error: exec_env or cur_frame is NULL\n");
+        return false;
+    }
+
+    cur_frame = exec_env_internal->cur_frame;
+    module_inst = (WASMModuleInstance *)exec_env_internal->module_inst;
+
+    if (!module_inst || !cur_frame->function) {
+        printf("[LM/Resume] Error: module_inst or cur_frame->function is NULL\n");
+        return false;
+    }
+
+    // 1. SAFE LOGGING (Only calculate bytecode offset if NOT an import function)
+    uint32_t ip_offset =
+        (!cur_frame->function->is_import_func) ? ptr_to_func_code_offset(cur_frame->function, cur_frame->ip) : 0;
+
+    printf("[LM/Resume] exec_env=%p cur_frame=%p module_inst=%p "
+           "function=%p prev_frame=%p ip=%p (offset=%u, is_import=%d) %f ms\n",
+           exec_env_internal, cur_frame, module_inst, cur_frame->function, cur_frame->prev_frame, cur_frame->ip,
+           ip_offset, cur_frame->function->is_import_func, get_time_in_ms());
+
+    printf("[LM/Resume] New function array base=%p count=%u\n", module_inst->e->functions,
+           module_inst->e->function_count);
+
+    if (cur_frame->function < module_inst->e->functions
+        || cur_frame->function >= module_inst->e->functions + module_inst->e->function_count) {
+        printf("[LM/Resume] Error: restored frame->function is outside "
+               "the current module function array\n");
+        return false;
+    }
+
+    // 2. SAFE IP CHECK (Only require ip != NULL for Wasm bytecode functions)
+    if (!cur_frame->function->is_import_func && !cur_frame->ip) {
+        printf("[LM/Resume] Error: restored bytecode frame->ip is NULL\n");
+        return false;
+    }
+
+    wasm_exec_env_set_cur_frame(exec_env_internal, cur_frame);
+
+    // If we are resuming into a native function, we don't need its restored frame
+    // because wasm_interp_call_func_native will allocate a new one.
+    if (cur_frame->function->is_import_func) {
+        resuming_native = true;
+        native_func = cur_frame->function;
+        wasm_exec_env_free_wasm_frame(exec_env_internal, cur_frame);
+        cur_frame = exec_env_internal->cur_frame;
+    }
+
+    // Clear any residual exception string prior to re-entry
+    wasm_set_exception(module_inst, NULL);
+
+    clock_t benchmark_end = clock();
+    double cpu_time_used = ((double)(benchmark_end - benchmark_start)) / CLOCKS_PER_SEC;
+    printf("[LM/Resume] Took %f ms to restore application\n", cpu_time_used * 1000.0);
+
+    // 3. DUAL DISPATCH (Native vs. Bytecode)
+    if (resuming_native) {
+        printf("[LM/Resume] Resuming native function: %s (%f)\n", native_func->u.func_import->field_name,
+               get_time_in_ms());
+        /* Resume execution via native interposer / membrane handler */
+        wasm_interp_call_func_native(module_inst, exec_env_internal, native_func, cur_frame);
+
+        /* After native function returns, we must continue execution in the caller */
+        cur_frame = exec_env_internal->cur_frame;
+        if (!cur_frame) {
+            return true;
+        }
+        module_inst = (WASMModuleInstance *)exec_env_internal->module_inst;
+        wasm_interp_call_func_bytecode(module_inst, exec_env_internal, NULL, cur_frame);
+    }
+    else {
+        printf("[LM/Resume] Resuming bytecode function (%f)\n", get_time_in_ms());
+        /* Resume execution via standard bytecode interpreter loop */
+        wasm_interp_call_func_bytecode(module_inst, exec_env_internal, NULL, cur_frame);
+    }
+
+    return !wasm_copy_exception(module_inst, NULL);
+}
